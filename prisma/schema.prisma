generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id               Int       @id @default(autoincrement())
  categoryId       Int       @map("category_id")
  productCode      String    @unique @db.VarChar(50) @map("product_code")
  name             String    @db.VarChar(200)
  sku              String?   @db.VarChar(50)
  barcode          String?   @unique @db.VarChar(50)
  price            Decimal?  @db.Decimal(10, 2)
  vendor           String?   @db.VarChar(100)
  location         String?   @db.VarChar(100)
  mainImage        String    @db.VarChar(255) @map("main_image")
  additionalImages String?   @db.Text @map("additional_images")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  category         Category  @relation(fields: [categoryId], references: [id])
  stocks           Stock[]

  @@map("products")
}

model Stock {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  quantity    Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stocks")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  position  String?  @db.VarChar(100)
  avatar    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
